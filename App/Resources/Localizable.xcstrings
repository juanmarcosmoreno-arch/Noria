    "An app and the files it created.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una app y los archivos que creó."
          }
        }
      }
    },
    "An identical copy of another file (same content, verified with SHA-256). At least one copy is always kept.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia idéntica de otro archivo (mismo contenido, verificado con SHA-256). Siempre se conserva al menos una copia."
          }
        }
      }
    },
