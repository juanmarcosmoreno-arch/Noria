    "%@ leftovers of apps you no longer have": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ restos de apps que ya no tienes"
          }
        }
      }
    },
    "%@ locations could not be read. macOS protects them unless you grant access.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron leer %@ ubicaciones. macOS las protege salvo que concedas acceso."
          }
        }
      }
    },
    "%@ marked safe": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ marcado como seguro"
          }
        }
      }
    },
    "%@ must be closed before cleaning its data, so nothing is lost while it is writing.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay que cerrar %@ antes de limpiar sus datos, para no perder nada mientras escribe."
          }
        }
      }
    },
    "%@ of %@": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ de %2$@"
          }
        }
      }
    },
    "%@ of attachments belong to accounts that keep mail only on this Mac (or whose type could not be confirmed). Noria leaves them alone; see the tips below.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ de adjuntos pertenecen a cuentas que guardan el correo solo en este Mac (o cuyo tipo no se pudo confirmar). Noria no los toca; mira los consejos de abajo."
          }
        }
      }
    },
    "%@ of swap in use: macOS is moving memory to the disk, which is slower.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ de swap en uso: macOS está pasando memoria al disco, que es más lento."
          }
        }
      }
    },
    "%@ of this app, matched by its exact identifier. %@": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ de esta app, identificado por su identificador exacto. %2$@"
          }
        }
      }
    },
    "%@ of “%@”. No installed app uses this identifier, and no other app from the same developer is installed. If you still use that app (for example from an external drive), keep it.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ de «%2$@». Ninguna app instalada usa este identificador y no hay otra app del mismo desarrollador. Si todavía usas esa app (por ejemplo desde un disco externo), consérvalo."
          }
        }
      }
    },
    "%@ recoverable": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ recuperables"
          }
        }
      }
    },
    "%@ recoverable · %@ items": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ recuperables · %2$@ elementos"
