    },
    "%@ safe items in %@": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ elementos seguros en %2$@"
          }
        }
      }
    },
    "%@ selected items are marked REVIEW. Make sure you no longer need them.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ elementos seleccionados están marcados como REVISAR. Asegúrate de que ya no los necesitas."
          }
        }
      }
    },
    "%@ skipped": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ omitidos"
          }
        }
      }
    },
    "%@ small files and folders grouped together. Open the folder in Finder to see them.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ archivos y carpetas pequeños agrupados. Abre la carpeta en Finder para verlos."
          }
        }
      }
    },
    "%@ were used in the last hour; %@ remain. A download, backup or app may be writing a lot.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ocuparon %1$@ en la última hora; quedan %2$@. Puede que una descarga, una copia de seguridad o una app esté escribiendo mucho."
          }
        }
      }
    },
    "%@ with the same name as the app. Probably belongs to it, but the match is by name only: check before removing. %@": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ con el mismo nombre que la app. Probablemente le pertenece, pero la coincidencia es solo por nombre: revísalo antes de eliminarlo. %2$@"
          }
        }
      }
    },
    "%@ · %@ files": {
      "extractionState": "manual",
      "localizations": {
