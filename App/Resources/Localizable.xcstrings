    "1. Open Privacy & Security › Full Disk Access.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Abre Privacidad y seguridad › Acceso total al disco."
          }
        }
      }
    },
    "2. Turn on Noria (use + to add it if it is not listed).": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Activa Noria (usa + para añadirla si no aparece)."
          }
        }
      }
    },
    "3. Quit and reopen Noria, then analyze Mail again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Cierra y vuelve a abrir Noria, y analiza Mail de nuevo."
          }
        }
      }
    },
