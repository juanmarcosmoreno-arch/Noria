    "%@ groups · %@ in extra copies": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ grupos · %2$@ en copias de más"
          }
        }
      }
    },
    "%@ in attachments": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ en adjuntos"
          }
        }
      }
    },
    "%@ is using %@ of a core. If you did not expect that, check whether it is stuck.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está usando el %2$@ de un núcleo. Si no lo esperabas, comprueba si se ha quedado bloqueado."
          }
        }
      }
    },
    "%@ items (%@) will be deleted and can no longer be restored. This frees the space.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán %1$@ elementos (%2$@) y ya no podrán restaurarse. Esto libera el espacio."
          }
        }
      }
    },
    "%@ items could not be restored because something already exists at their original location. Use Reveal to recover them manually.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron restaurar %@ elementos porque ya existe algo en su ubicación original. Usa Mostrar en Finder para recuperarlos a mano."
          }
        }
      }
    },
    "%@ items restored to their original location.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ elementos restaurados en su ubicación original."
          }
        }
      }
    },
    "%@ items selected": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ elementos seleccionados"
          }
