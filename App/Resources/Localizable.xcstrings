    },
    "Only files with byte-for-byte identical content are listed (same size and SHA-256). Names do not matter. Photos and other app libraries, apps and ~/Library are not searched.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se muestran archivos con contenido idéntico byte a byte (mismo tamaño y SHA-256). Los nombres no importan. No se buscan en Fotos ni otras bibliotecas de apps, apps ni ~/Library."
          }
        }
